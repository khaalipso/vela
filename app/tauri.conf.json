{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vela",
  "version": "0.1.0",
  "identifier": "dev.vela.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm -C ../ui dev",
    "beforeBuildCommand": "pnpm -C ../ui build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vela",
        "width": 1440,
        "height": 900,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "An editor built around tasks, for people who code with agents",
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
